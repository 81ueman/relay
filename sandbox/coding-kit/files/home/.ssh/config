# ISH-827: the sandbox egress policy has no :22 rule, and GitHub's port 22 is
# not usable from a Docker Sandboxes microVM (see ISH-822 evidence 16/17).
# Route SSH to GitHub over the public ssh.github.com:443 endpoint instead.
# The SSH *agent* is forwarded by Docker Sandboxes; no key file lives here.
Host github.com
  HostName ssh.github.com
  Port 443
  User git

Host ssh.github.com
  Port 443
