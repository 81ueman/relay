{
  "name": "relay",
  "version": "0.1.0",
  "description": "Lightweight deterministic supervisor that keeps Herdr + OpenCode agents moving while SQLite stays the source of truth.",
  "type": "module",
  "bin": {
    "relay": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "install:local": "bun scripts/install.sh",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke:run-lifecycle": "bun scripts/ish760-smoke.ts",
    "smoke:sandbox": "bun scripts/ish828-smoke.ts",
    "smoke:sandbox:real": "bun scripts/ish828-real-smoke.ts",
    "smoke:verify-in-sandbox": "bun scripts/ish829-real-smoke.ts",
    "smoke:verify-in-sandbox:real": "RELAY_SANDBOX_SMOKE=1 bun scripts/ish829-real-smoke.ts",
    "smoke:merge-gate": "bun scripts/ish761-smoke.ts",
    "smoke:factory": "bun scripts/ish762-smoke.ts",
    "smoke:factory:real": "RELAY_REAL_SMOKE=1 bun scripts/ish762-real-smoke.ts",
    "smoke:pr-binding:real": "RELAY_ISH885_E2E=1 bun scripts/ish885-real-e2e.ts",
    "smoke:agent-pr-e2e": "RELAY_ISH885B_E2E=1 bun scripts/ish885b-real-agent-e2e.ts",
    "daemon": "bun src/cli.ts daemon",
    "formal": "formal/run-tlc.sh Relay",
    "formal:safety": "formal/run-tlc.sh RelaySafety",
    "formal:scheduling": "formal/run-tlc.sh RelayScheduling",
    "formal:roles": "formal/run-tlc.sh RelayRoles",
    "formal:tree": "formal/run-tlc.sh RelayTree",
    "formal:recovery": "formal/run-tlc.sh RelayRecovery",
    "formal:liveness": "formal/run-tlc.sh RelayLiveness",
    "formal:completion": "formal/run-tlc.sh RelayCompletion",
    "formal:mutations": "formal/run-mutations.sh",
    "formal:done": "formal/run-tlc.sh RelayDone",
    "formal:failures": "formal/run-tlc.sh RelayFailures"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
