{
  "name": "relay",
  "version": "0.1.0",
  "description": "Lightweight deterministic supervisor that keeps Herdr + OpenCode agents moving while SQLite stays the source of truth.",
  "type": "module",
  "bin": {
    "relay": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "daemon": "bun src/cli.ts daemon",
    "formal": "formal/run-tlc.sh Relay",
    "formal:liveness": "formal/run-tlc.sh RelayLiveness",
    "formal:done": "formal/run-tlc.sh RelayDone",
    "formal:failures": "formal/run-tlc.sh RelayFailures"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
